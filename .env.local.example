# =============================================================================
# Local environment for bench-web-template
# =============================================================================
#
#   cp .env.local.example .env.local
#
# .env.local is gitignored. Never commit real values.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (local Postgres from `docker compose up -d`)
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://app:app@localhost:55432/app

# -----------------------------------------------------------------------------
# Sign-in: Microsoft Entra ID app registration (README → "Entra app registration")
# Redirect URI for local dev: http://localhost:3000/api/auth/callback/microsoft-entra-id
# -----------------------------------------------------------------------------
AZURE_AD_CLIENT_ID=<ENTRA_CLIENT_ID>
AZURE_AD_CLIENT_SECRET=<ENTRA_CLIENT_SECRET>
AZURE_AD_TENANT_ID=<TENANT_ID>

# Auth.js session secret. Generate with: openssl rand -base64 32
AUTH_SECRET=<AUTH_SECRET>

# Only emails in this domain may sign in (case-insensitive). Defaults to ingagepartners.com
# when unset or empty. Set to * to allow every account in the tenant.
ALLOWED_EMAIL_DOMAIN=ingagepartners.com

# -----------------------------------------------------------------------------
# Auth bypass for local development without Entra credentials.
# Signs you in as e2e@example.com. Ignored when NODE_ENV=production.
# -----------------------------------------------------------------------------
# E2E_AUTH_BYPASS=true

# -----------------------------------------------------------------------------
# Azure only — set on the Container App, not here:
#   PGHOST, PGDATABASE, PGUSER   Postgres with Entra token auth (instead of DATABASE_URL)
#   AZURE_CLIENT_ID              user-assigned managed identity used for the Postgres token
#   APPLICATIONINSIGHTS_CONNECTION_STRING   enables telemetry
#   AUTH_URL                     public https URL of the app
# Don't set AUTH_URL here: localhost is detected automatically in dev.
# -----------------------------------------------------------------------------
