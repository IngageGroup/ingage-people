{
  "name": "ingage-people",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ingest": "node --env-file-if-exists=.env.local --import tsx src/knowledge/cli.ts",
    "eval": "node --env-file-if-exists=.env.local --import tsx src/eval/run.ts",
    "eval:generate": "node --env-file-if-exists=.env.local --import tsx src/eval/generate.ts",
    "test:db": "vitest run --config vitest.db.config.mts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@azure/identity": "4.14.1",
    "@azure/monitor-opentelemetry": "1.21.0",
    "@ingagegroup/ingage-design-tokens": "0.1.0",
    "@ingagegroup/ingage-react": "0.1.1",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "pdfjs-dist": "6.5.438",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "windows-iana": "5.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@azure/monitor-opentelemetry-exporter": "1.0.0-beta.47",
    "@biomejs/biome": "2.4.8",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "25.5.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "dotenv": "17.3.1",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@10.29.3"
}
